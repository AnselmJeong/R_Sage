                  "key": "variable",
                  "label": "변수",
                  "type": "column",
                  "types": [
                    "numeric",
                    "date",
                    "character",
                    "factor"
                  ]
                },
                {
                  "key": "min",
                  "label": "최소",
                  "type": "text",

{
  "formVersion": 2,
  "about": {
    "summary": "스프레드시트로 받은 데이터를 분석하기 전에 무결성과 정제 상태를 점검합니다. 변수명과 빈 행 같은 구조, 숫자·날짜·코드의 형식, 이상치와 직접 정한 규칙, 결측과 중복, 텍스트 표기를 차례로 보고, 점검 요약 표에 문제와 해결 방법을 모읍니다. 변수 진단·이상치·범주 진단과 보고서는 dlookr로 계산합니다.",
    "links": [
      {
        "label": "dlookr 홈페이지",
        "url": "https://choonghyunryu.github.io/dlookr/"
      },
      {
        "label": "dlookr 데이터 진단 안내",
        "url": "https://choonghyunryu.github.io/dlookr/articles/diagonosis.html"
      }
    ],
    "showcase": [
      {
        "title": "데이터 전체를 한눈에 진단하기",
        "description": "행·열 수, 중복 행, 결측, 변수 형식 개요와 변수마다 형식·결측·고유값 수를 표로 봅니다.",
        "fn": [
          "dlookr::overview",
          "dlookr::diagnose"
        ],
        "enable": {
          "overview": true,
          "diagnose": true
        }
      },
      {
        "title": "수치 변수 진단하기",
        "description": "최솟값·사분위수·최댓값과 0·음수·이상치 개수. 나올 수 없는 값(나이 -5)이 바로 보입니다.",
        "fn": [
          "dlookr::diagnose_numeric"
        ],
        "enable": {
          "values.numeric": true
        }
      },
      {
        "title": "이상치 찾고 그려 보기",
        "description": "변수마다 이상치 개수와 이상치를 뺀 평균, 상자그림과 이상치가 있는 행 번호.",
        "fn": [
          "dlookr::diagnose_outlier",
          "dlookr::plot_outlier"
        ],
        "enable": {
          "values.outliers": true,
          "values.outlierPlot": true,
          "values.outlierRows": true
        }
      },
      {
        "title": "범주 변수 진단하기",
        "description": "범주 값마다 행 수와 비율, 드물게 나오는 값(오타 의심).",
        "fn": [
          "dlookr::diagnose_category"
        ],
        "enable": {
          "text.categories": true,
          "values.rareLevels": true
        }
      },
      {
        "title": "결측을 파레토 그림으로 보기",
        "description": "결측 비율이 큰 변수부터 막대로, 누적 비율을 선으로. dlookr의 결측 등급(좋음~제거 고려)으로 색칠합니다.",
        "fn": [
          "dlookr::plot_na_pareto"
        ],
        "enable": {
          "missing.pareto": true,
          "missing.hidden": true
        }
      },
      {
        "title": "진단 보고서 파일 만들기",
        "description": "dlookr의 HTML 데이터 진단 보고서를 파일로 저장합니다. 동료에게 보내거나 원본 담당자에게 확인을 요청할 때 씁니다.",
        "fn": [
          "dlookr::diagnose_web_report",
          "dlookr::diagnose_paged_report"
        ],
        "enable": {
          "report.enabled": true
        }
      },
      {
        "title": "스프레드시트 형식 오류 찾기",
        "description": "숫자 열에 섞인 '1,000원'·'N/A', 섞인 날짜 형식, 앞자리 0이 지워진 코드, 변수명 문제, 빈 행.",
        "enable": {
          "format.numberText": true,
          "format.dates": true,
          "format.leadingZeros": true,
          "structure.names": true,
          "structure.emptyRows": true
        }
      },
      {
        "title": "규칙으로 값 검증하기",
        "description": "허용 범위(나이 0~120), 허용 값(성별 남·여), 선후 관계(주문일 ≤ 배송일)를 정하면 어긴 행을 찾습니다.",
        "enable": {
          "values.numeric": true
        },
        "needs": "'값의 범위와 규칙'에서 규칙을 추가하세요.",
        "needsFilled": [
          "values.ranges"
        ]
      },
      {
        "title": "키와 필수값 점검하기",
        "description": "회원번호처럼 하나뿐이어야 할 키의 중복과 빈 값, 필수 변수의 빈 칸을 찾습니다.",
        "enable": {
          "duplicates.keys": true,
          "duplicates.rows": true
        },
        "needs": "키 변수를 넣으세요.",
        "needsFilled": [
          "keys"
        ]
      },
      {
        "title": "텍스트 표기 통일하기",
        "description": "앞뒤 공백, 대소문자만 다른 값, 철자가 비슷한 값, 동의어(한국·대한민국·KOREA)를 찾습니다.",
        "enable": {
          "text.whitespace": true,
          "text.variants": true,
          "text.similar": true
        }
      },
      {
        "title": "정리한 데이터 만들기",
        "description": "찾은 문제를 고친 사본을 R 세션에 저장합니다. 원본은 바뀌지 않고, 무엇을 몇 개 바꿨는지 표로 남습니다.",
        "enable": {
          "clean.enabled": true
        }
      }
    ]
  },
  "roles": [
    {
      "type": "variables",
      "bind": "variables",
      "label": "점검할 변수",
      "hint": "비워 두면 모든 변수를 점검합니다."
    },
    {
      "type": "variables",
      "bind": "keys",
      "label": "키 변수",
      "hint": "함께 한 행을 가리키는 변수(회원번호, 주문번호). 중복과 빈 값을 봅니다."
    },
    {
      "type": "variables",
      "bind": "required",
      "label": "필수 변수",
      "hint": "모든 행에 있어야 하는 변수(ID, 이메일)."
    }
  ],
  "sections": [
    {
      "title": "요약",
      "open": true,
      "controls": [
        {
          "type": "checkbox",
          "bind": "overview",
          "label": "데이터 개요",
          "description": "행·열 수, 중복 행, 결측 있는 행, 변수 형식의 개수.",
          "fn": "dlookr::overview"
        },
        {
          "type": "checkbox",
          "bind": "diagnose",
          "label": "변수 진단",
          "description": "변수마다 R이 읽은 형식, 결측 수와 비율, 서로 다른 값의 수.",
          "fn": "dlookr::diagnose"
        },
        {
          "type": "number",
          "bind": "maxExamples",
          "label": "문제마다 보여 줄 예",
          "unit": "개"
        }
      ]
    },
    {
      "title": "구조",
      "description": "데이터의 틀: 변수명, 빈 행과 빈 열.",
      "controls": [
        {
          "type": "checkbox",
          "bind": "structure.names",
          "label": "변수명 점검",

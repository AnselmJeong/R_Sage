              "bind": "clean.synonyms",
              "label": "동의어 통일",
              "description": "동의어 규칙의 대표 표기로."
            },
            {
              "type": "checkbox",
              "bind": "clean.variants",
              "label": "표기 통일",
              "description": "대소문자·공백만 다른 값을 가장 흔한 표기로."
            },
            {
              "type": "checkbox",
              "bind": "clean.numbers",
              "label": "숫자로 바꾸기",
              "description": "숫자 열에 섞인 쉼표·단위를 지우고 숫자로. 숫자가 아닌 값은 NA."
            },
            {
              "type": "checkbox",
              "bind": "clean.dates",
              "label": "날짜로 바꾸기",
              "description": "여러 형식의 날짜 텍스트를 Date로. 읽히지 않는 값은 NA."
            },
            {
              "type": "checkbox",
              "bind": "clean.padZeros",
              "label": "앞자리 0 채우기",
              "description": "코드를 가장 긴 자릿수에 맞춰 0을 채운 텍스트로."
            },
            {
              "type": "checkbox",
              "bind": "clean.ruleViolations",
              "label": "규칙 위반 값을 NA로",
              "description": "허용 범위·허용 값 규칙을 어긴 값을 NA로. 원본을 확인한 뒤에 켭니다."
            },
            {
              "type": "checkbox",
              "bind": "clean.emptyRows",
              "label": "빈 행 지우기",
              "description": "모든 칸이 빈 행을 지웁니다."
            },
            {
              "type": "checkbox",
              "bind": "clean.duplicates",
              "label": "중복 행 지우기",
              "description": "같은 행은 첫 행만 남깁니다.",
              "fn": "dplyr::distinct"
            },
            {
              "type": "checkbox",
              "bind": "clean.emptyColumns",
              "label": "빈 열 지우기",
              "description": "값이 없는 열을 지웁니다."
            },
            {
              "type": "checkbox",
              "bind": "clean.names",
              "label": "변수명 정리",
              "description": "공백을 _로, 특수문자를 빼고, 중복 이름에 번호를 붙입니다."
            },
            {
              "type": "text",
              "bind": "clean.saveAs",
              "label": "저장할 이름",
              "placeholder": "data_clean",
              "hint": "비우면 저장하지 않습니다."
            }
          ]
        }
      ]
    },
    {
      "title": "진단 보고서",
      "description": "dlookr가 만드는 HTML 보고서 파일.",
      "controls": [
        {
          "type": "checkbox",
          "bind": "report.enabled",
          "label": "진단 보고서 저장",
          "description": "데이터 진단 보고서를 HTML 파일로 저장합니다. 따로 R을 띄워 만들어서 수십 초 걸립니다.",
          "fn": "dlookr::diagnose_web_report",
          "controls": [
            {
              "type": "select",
              "bind": "report.format",
              "label": "형식",
              "labels": {
                "web": "웹 보고서 (탭으로 나뉨)",
                "paged": "인쇄용 페이지 보고서"
              }
            },
            {
              "type": "text",
              "bind": "report.file",
              "label": "파일",
              "placeholder": "data-diagnosis.html",
              "hint": "작업 폴더 기준 경로입니다."
            }
          ],
          "requires": [
            "rmarkdown"
          ]
        }
      ]
    }
  ]
}
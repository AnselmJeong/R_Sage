{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun"],
    "lib": ["ES2022"]
  },
  "include": ["packages/zmtp/src", "packages/kernel/src", "packages/host/src", "packages/shared/src", "scripts"]
}
